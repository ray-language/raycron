//! When a job fires. The `cron` package computes fire times in UTC only; local time comes from
//! the `tz` package, walking real time and jumping by civil distance:
//!
//! - a time that occurs once fires once;
//! - a time skipped by a spring-forward gap fires at the moment of the jump (as Vixie cron does);
//! - a time repeated by a fall-back fires once for jobs pinned to an hour (`30 2 * * *`), and in
//!   both passes for jobs that run every hour (`*/15 * * * *`), so their spacing holds in real time.

import std/time;
import cron/cron;
import tz/tz;

/// Where a schedule's fields are read: an IANA zone, or UTC.
pub struct Zone {
    name: string,
    zone: Option<tz.Zone>,
}

pub fn utc() -> Zone {
    Zone { name: "UTC", zone: Option.None }
}

pub fn load(name: string) -> Result<Zone, string> {
    if (name == "UTC" || name == "Etc/UTC") {
        return Result.Ok(utc());
    }
    Result.Ok(Zone { name: name, zone: Option.Some(tz.load(name)?) })
}

/// The system's zone: `TZ`, `/etc/localtime`, or the operating system's own rules (Windows, where
/// there is no zoneinfo database). UTC only if even that fails.
pub fn system() -> Zone {
    match (tz.system()) {
        Result.Ok(z) => Zone { name: tz.name(z), zone: Option.Some(z) },
        Result.Err(_) => utc(),
    }
}

pub fn offset(z: Zone, ms: int) -> int {
    match (z.zone) {
        Option.Some(zz) => tz.offset_at(zz, ms),
        Option.None => 0,
    }
}

/// The civil time of an instant, as "naive" epoch milliseconds (the wall clock read as if UTC).
pub fn civil(z: Zone, ms: int) -> int {
    ms + offset(z, ms)
}

pub fn abbrev(z: Zone, ms: int) -> string {
    match (z.zone) {
        Option.Some(zz) => tz.abbrev_at(zz, ms),
        Option.None => "UTC",
    }
}

/// `2026-10-25 02:30 CET`.
pub fn show(z: Zone, ms: int) -> string {
    let t = time.from_epoch_millis(civil(z, ms));
    "${t.year}-${two(t.month)}-${two(t.day)} ${two(t.hour)}:${two(t.minute)} ${abbrev(z, ms)}"
}

fn two(n: int) -> string {
    if (n < 10) { "0${n}" } else { to_string(n) }
}

/// The first instant in (lo, hi] whose civil time is at least `target`, knowing civil(lo) <
/// target <= civil(hi): the end of a spring-forward gap.
fn first_reaching(z: Zone, lo: int, hi: int, target: int) -> int {
    var a = lo;
    var b = hi;
    while (b - a > 1000) {
        let mid = a + (b - a) / 2;
        if (civil(z, mid) >= target) {
            b = mid;
        } else {
            a = mid;
        }
    }
    // Transitions fall on whole seconds.
    b - (b % 1000)
}

/// The next fire time strictly after `after` (epoch ms).
pub fn next_fire(s: cron.Schedule, z: Zone, after: int) -> Result<int, string> {
    var low = after;
    var target = cron.next_after(s, civil(z, after))?;
    var t = after + (target - civil(z, after));
    // Each pass either fires or moves `t` forward; offsets change at most a few times a year, so
    // this settles in a few passes. The bound only guards against a broken zone.
    for _ in 0..64 {
        let c = civil(z, t);
        if (c == target && t > after) {
            return Result.Ok(t);
        }
        if (c > target) {
            // The target civil time was skipped: fire when the clock jumps over it.
            let at = first_reaching(z, low, t, target);
            if (at > after) {
                return Result.Ok(at);
            }
            target = cron.next_after(s, c)?;
            low = t;
            t = t + (target - c);
        } else if (c < target) {
            // The offset dropped on the way (fall-back): civil time went back, so the first match
            // at or after `c` may be earlier than `target`. For a job pinned to an hour, the jump
            // that got here already passed the repeated hour; one that runs every hour finds its
            // next minute inside it.
            target = cron.next_after(s, c - 1)?;
            low = t;
            t = t + (target - c);
        } else {
            target = cron.next_after(s, c)?;
            low = t;
            t = t + (target - c);
        }
    }
    Result.Err("no fire time found after ${after} (zone ${z.name})")
}

/// The next `n` fire times after `after`.
pub fn upcoming(s: cron.Schedule, z: Zone, after: int, n: int) -> Result<[int], string> {
    let out: [int] = [];
    var t = after;
    while (out.len() < n) {
        t = next_fire(s, z, t)?;
        out.push(t);
    }
    Result.Ok(out)
}
